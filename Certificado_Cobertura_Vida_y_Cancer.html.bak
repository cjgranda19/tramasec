<div>
    <table width="100%" cellpadding="0" cellspacing="0" style="border:0;">
        <tbody><tr><td style="border:0; width:65%;"></td><td style="border:0; width:35%; text-align:right;"><img src="data:image/jpeg;base64," style="width:130px;"></td></tr>
