    $contrato = $contrato ?? null;

    $fechaInclusionCancerRaw = data_get($cotizador, 'fecha_inclusion', data_get($informacion_titular, 'fecha_inclusion'));
    $corteCancerPrimario = \Carbon\Carbon::parse('2023-08-01');
    $fechaInclusionCancerValida = null;
    if (!empty($fechaInclusionCancerRaw)) {
        try {
            $fechaInclusionCancerValida = \Carbon\Carbon::parse($fechaInclusionCancerRaw);
        } catch (\Exception $e) {
            $fechaInclusionCancerValida = null;
        }
    }

    if (!$fechaInclusionCancerValida) {
        $montoCancerPrimario = '1.000,00';
        $textoCoberturaCancerPrimario = 'BMI pagará por concepto del beneficio otorgado por el presente endoso, la suma estipulada en las condiciones particulares de la Póliza si al Titular Asegurado se le diagnostica Cáncer Primario.';
    } elseif ($fechaInclusionCancerValida-&gt;lt($corteCancerPrimario)) {
        $montoCancerPrimario = '1.500,00';
        $textoCoberturaCancerPrimario = 'Cobertura por Cáncer Primario de hasta $1.500,00 para el titular asegurado con inclusión hasta el 31 de Julio del 2023 cuya prima por concepto de este beneficio se encuentre paga.';
    } else {
        $montoCancerPrimario = '2.500,00';
        $textoCoberturaCancerPrimario = 'Cobertura por Cáncer Primario de hasta $2.500,00 para el titular asegurado con inclusión desde el 01 de Agosto del 2023 cuya prima por concepto de este beneficio se encuentre paga.';
    }

    $vigenciaDesdeRaw = data_get($cotizador, 'inicio_vigencia');
    $vigenciaHastaRaw = data_get($cotizador, 'fin_vigencia');
    $vigenciaDesde = '';
