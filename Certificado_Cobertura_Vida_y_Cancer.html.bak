        try { $vigenciaDesde = \Carbon\Carbon::parse($vigenciaDesdeRaw)-&gt;format('d/m/Y'); } catch (\Exception $e) { $vigenciaDesde = ''; }
    }
    if (!empty($vigenciaHastaRaw)) {
        try { $vigenciaHasta = \Carbon\Carbon::parse($vigenciaHastaRaw)-&gt;format('d/m/Y'); } catch (\Exception $e) { $vigenciaHasta = ''; }
    }

    $planVidaTexto = data_get($cotizador, 'plan_vida', '');
    $dependientesLista = collect($dependientes ?? []);

    $valorAsegurado = round((float) data_get($cotizador_primer_endoso, 'valor_asegurado', 0), 2);
    $primaNeta = round((float) data_get($cotizador_primer_endoso, 'prima_neta', 0), 2);
    $primaTotal = round((float) data_get($cotizador_primer_endoso, 'prima_total', 0), 2);

