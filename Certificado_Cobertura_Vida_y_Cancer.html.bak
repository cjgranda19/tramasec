    $titularCelular = data_get($informacion_titular, 'celular', '');
    $titularEmail = data_get($informacion_titular, 'email', '');
    $titularTelefono = data_get($informacion_titular, 'telefono', '');
    $ciudadAgencia = data_get($contrato, 'usuario.agencia.ciudad_nombre', '');
    $fechaHoy = \Carbon\Carbon::now()-&gt;format('d/m/Y');
    $fechaHoyCompacta = \Carbon\Carbon::now()-&gt;format('dmY');

    $numeroOperacion = data_get($cotizador, 'numero_operacion', '');
    $numeroPoliza = '558200000';
